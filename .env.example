# Copy to .env.local for development. Never commit real values —
# production secrets live in Vercel project env vars only (10-quality-and-launch.md §3).

# --- Analytics --------------------------------------------------------
NEXT_PUBLIC_GA4_MEASUREMENT_ID=

# --- Anti-spam ----------------------------------------------------------
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Rate limiting (Upstash Redis, free tier) --------------------------
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Monitoring ----------------------------------------------------------
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# --- Forms → CRM/webhook adapter (09-seo-analytics-crm.md §3) ----------
# Phase 1: generic webhook forwarding. Phase 3: real CRM adapter.
LEAD_WEBHOOK_URL=
CRM_ADAPTER=webhook

# --- Email / newsletter provider (DEVELOPER DECISION REQUIRED: Brevo vs ConvertKit) ---
NEWSLETTER_PROVIDER=
NEWSLETTER_API_KEY=

# --- Books commerce, Phase 3 only (DEVELOPER DECISION REQUIRED: Stripe vs Lemon Squeezy) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Site ----------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
