# Copy to .env.local for local work. On Vercel, add the same names under
# Project Settings > Environment Variables. Never commit real values.
# Restart `npm run dev` after changing this file.

# --- Forms (Resend) -----------------------------------------------------------
# Until RESEND_API_KEY, FORMS_TO_EMAIL and FORMS_FROM_EMAIL are all set, the enquiry forms
# (contact, speaking, cohort application) tell the sender their message was not sent.

# Resend > API Keys > Create API key. Choose "Full access": a "Sending access" key can send
# email but cannot add "Notify me" sign-ups as contacts. Starts with re_
RESEND_API_KEY=

# Inbox that receives contact, speaking and cohort application emails. Comma-separate several.
# Replies go straight to the person who filled in the form.
FORMS_TO_EMAIL=

# Sender, on a domain verified under Resend > Domains, e.g.
#   Victor Sonde Website <website@victorsonde.com>
# For a first local test before the domain is verified, use: Victor Sonde <onboarding@resend.dev>
# (Resend then only delivers to the email address your Resend account is registered with.)
FORMS_FROM_EMAIL=

# "Notify me" is double opt-in: sign-ups get a confirmation email from FORMS_FROM_EMAIL and are only
# added to Resend contacts (with a welcome email) once they click the link. Links are signed with a
# key derived from RESEND_API_KEY, so rotating that key voids unconfirmed links.

# Public site address used in confirmation links, e.g. https://victorsonde.com
# Optional on Vercel (falls back to the production domain) and locally (http://localhost:3000).
SITE_URL=

# Optional. Resend > Audience > Segments > create "Cohort updates" and paste its ID here.
# Without it, "Notify me" sign-ups are still saved under Resend > Audience > Contacts.
RESEND_SEGMENT_ID=
