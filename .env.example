# Copy to .env.local for local work. On Vercel, add the same names under
# Project Settings > Environment Variables. Never commit real values.

# --- Forms (Resend) -----------------------------------------------------------
# Until RESEND_API_KEY, FORMS_TO_EMAIL and FORMS_FROM_EMAIL are all set, enquiry forms
# tell the sender their message was not sent.
RESEND_API_KEY=
# Inbox(es) that receive contact, speaking and cohort application emails. Comma-separate several.
FORMS_TO_EMAIL=
# Sender on a domain verified in Resend, e.g. Victor Sonde Website <website@victorsonde.com>
FORMS_FROM_EMAIL=
# Optional: Resend segment that "Notify me" sign-ups are added to. Without it they are still
# saved as Resend contacts.
RESEND_SEGMENT_ID=
